# Canonical PostgreSQL runtime state.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/styxcd

# Outbound GitHub provider credential used by confirmed provider workflows.
GITHUB_TOKEN=replace-with-a-server-owned-token

# Optional; retained for compatibility with the current CLI default.
JOHNNY_JOHNNY_PROVIDER_ACCOUNT=ggortsema

# Auth0 resource-server validation. The audience must exactly match the
# Identifier of the Auth0 API. The domain may be a tenant or custom domain.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.johnny-johnny.local

# Local convenience. Consider false for an internet-facing deployment.
JOHNNY_JOHNNY_API_DOCS_ENABLED=true

# Optional validation tuning. Defaults shown.
AUTH0_CLOCK_SKEW_SECONDS=30
AUTH0_JWKS_TIMEOUT_SECONDS=5
AUTH0_JWKS_CACHE_SECONDS=300
